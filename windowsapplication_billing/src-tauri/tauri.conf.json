{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taj POS",
  "version": "1.0.0",
  "identifier": "com.tajpos.billing",
  "build": {
    "beforeDevCommand": "cd .. && npm run dev -- --webpack",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "cd .. && cross-env TAURI_BUILD=1 next build",
    "frontendDist": "../../out"
  },
  "app": {
    "windows": [
      {
        "title": "Taj POS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Taj POS",
    "copyright": "2024 Hotel Taj Ooty"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.tajpos.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}